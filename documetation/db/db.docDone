##### DataBase
- ROLE
    .COLUMNS
        ID(BIGINT)
        ROLE_TYPE[ENUM('ROLE_ADMIN', 'ROLE_COLLABORATOR', 'ROLE_WORKER' , 'ROLE_USER')]

- USERS
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        EMAIL(STRING)
        PASSWORD(STRING)
        STATUS(BOOLEAN)

-ROLE_USERS
    .COLUMNS
        USERS_ID(FK)
        ROLE_ID(FK)

- REFRESH_TOKENS
    .COLUMNS
        ID(BIGINT)
        TOKEN(STRING)
        EXPIRES_AT
        USER_ID(FK)

- COLLABORATORS
    .COLUMNS
        USER_ID(FK PRIMARY KEY)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- ENTERPRISE
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        CNPJ(STRING UNIQUE)
        COLLABORATOR_ID(FK)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- COUNTRIES
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        CODE(STRING)
        CREATED_AT(TIMESTAMP)
	UPDATED_AT(TIMESTAMP)

- STATES
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        COUNTRY_ID(FK)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- CITIES
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        STATE_ID(FK)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- ADDRESS_ENTERPRISE
    .COLUMNS
        ID(BIGINT PK & FK -> ENTERPRISE.ID)
        STREET(STRING)    ZIP_CODE(STRING)
        NUMBER(STRING)    COMPLEMENT(STRING)
        NEIGHBORHOOD(STRING)    CITY_ID(FK)
        CREATED_AT(TIMESTAMP)    UPDATED_AT(TIMESTAMP)

- TOPICS
    .COLUMNS
        ID(BIGINT)
        TOPIC_TYPE(ENUM('LANGUAGE', 'TECHNOLOGY', 'SOFT_SKILLS'))
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- SKILLS
    .COLUMNS
        ID(BIGINT)
        NAME(STRING)
        DESCRIPTION(STRING)
        TOPIC_ID(FK -> TOPICS.ID)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- JOBS
    .COLUMNS
        ID(BIGINT)
        POSITION(STRING)
        ENTERPRISE_ID(FK -> ENTERPRISE.ID)
        DESCRIPTION(TEXT)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- JOBS_SKILLS
    .COLUMNS
        JOB_ID(FK -> JOBS.ID)
        SKILL_ID(FK -> SKILLS.ID)
        PRIMARY_KEY(JOB_ID, SKILL_ID)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)

- VACANCIES
    .COLUMNS
        ID(BIGINT)
        JOB_ID(FK -> JOBS.ID)
        VACANCIES_NUMBER(INTEGER)
        STATUS(BOOLEAN DEFAULT TRUE)
        CREATED_AT(TIMESTAMP)
        UPDATED_AT(TIMESTAMP)